<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_OrderDelivery"
                  targetNamespace="http://example.com/lab3/order-delivery">
  <bpmn:message id="Message_DeliveryAccepted" name="Доставку прийнято" />
  <bpmn:message id="Message_DeliveryArrived" name="Приїхала доставка" />
  <bpmn:dataStore id="DataStore_OrderRegistry" name="Сховище замовлень" />

  <bpmn:process id="Process_Manager" name="Робота менеджера" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderNeeded" name="Потрібно створити замовлення">
      <bpmn:outgoing>Flow_Manager_Start_Create</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CreateOrder" name="Створити замовлення">
      <bpmn:incoming>Flow_Manager_Start_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_Create_Send</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutput_Create_OrderRegistry">
        <bpmn:targetRef>DataStoreReference_OrderRegistry</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataStoreReference id="DataStoreReference_OrderRegistry" name="Сховище замовлень" dataStoreRef="DataStore_OrderRegistry" />
    <bpmn:sendTask id="Task_SendOrder" name="Надіслати замовлення підряднику">
      <bpmn:incoming>Flow_Manager_Create_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_Send_Wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_WaitForResult" name="Очікувати результат або завершення строку">
      <bpmn:incoming>Flow_Manager_Send_Wait</bpmn:incoming>
      <bpmn:incoming>Flow_Manager_WaitAgain</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_Wait_AcceptedMessage</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manager_Wait_Deadline</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_DeliveryAccepted" name="Отримано повідомлення: доставку прийнято">
      <bpmn:incoming>Flow_Manager_Wait_AcceptedMessage</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_Accepted_End</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageCatchDefinition_DeliveryAccepted" messageRef="Message_DeliveryAccepted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_ManagerAccepted" name="Менеджера повідомлено">
      <bpmn:incoming>Flow_Manager_Accepted_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_DeadlineExpired" name="Строк доставки минув">
      <bpmn:incoming>Flow_Manager_Wait_Deadline</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_Deadline_Contact</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_DeadlineExpired">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression"><![CDATA[зазначений строк доставки]]></bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ContactTransportCompany" name="Зв'язатися з транспортною компанією">
      <bpmn:incoming>Flow_Manager_Deadline_Contact</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_Contact_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TransportDecision" name="Рішення після відповіді компанії" default="Flow_Manager_StopWaiting">
      <bpmn:incoming>Flow_Manager_Contact_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_WaitAgain</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manager_StopWaiting</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_StopWaiting" name="Очікування припинено">
      <bpmn:incoming>Flow_Manager_StopWaiting</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Manager_Start_Create" sourceRef="StartEvent_OrderNeeded" targetRef="Task_CreateOrder" />
    <bpmn:sequenceFlow id="Flow_Manager_Create_Send" sourceRef="Task_CreateOrder" targetRef="Task_SendOrder" />
    <bpmn:sequenceFlow id="Flow_Manager_Send_Wait" sourceRef="Task_SendOrder" targetRef="Gateway_WaitForResult" />
    <bpmn:sequenceFlow id="Flow_Manager_Wait_AcceptedMessage" sourceRef="Gateway_WaitForResult" targetRef="IntermediateCatch_DeliveryAccepted" />
    <bpmn:sequenceFlow id="Flow_Manager_Accepted_End" sourceRef="IntermediateCatch_DeliveryAccepted" targetRef="EndEvent_ManagerAccepted" />
    <bpmn:sequenceFlow id="Flow_Manager_Wait_Deadline" sourceRef="Gateway_WaitForResult" targetRef="IntermediateCatch_DeadlineExpired" />
    <bpmn:sequenceFlow id="Flow_Manager_Deadline_Contact" sourceRef="IntermediateCatch_DeadlineExpired" targetRef="Task_ContactTransportCompany" />
    <bpmn:sequenceFlow id="Flow_Manager_Contact_Decision" sourceRef="Task_ContactTransportCompany" targetRef="Gateway_TransportDecision" />
    <bpmn:sequenceFlow id="Flow_Manager_WaitAgain" name="Чекати доставку" sourceRef="Gateway_TransportDecision" targetRef="Gateway_WaitForResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[рішення = чекати доставку]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Manager_StopWaiting" name="Припинити очікування" sourceRef="Gateway_TransportDecision" targetRef="EndEvent_StopWaiting" />
  </bpmn:process>

  <bpmn:process id="Process_WarehouseWorker" name="Робота комірника" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderDelivered" name="Приїхала доставка">
      <bpmn:outgoing>Flow_Warehouse_Start_GetOrder</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageStartDefinition_OrderDelivered" messageRef="Message_DeliveryArrived" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_GetOrderData" name="Отримати дані замовлення зі сховища">
      <bpmn:incoming>Flow_Warehouse_Start_GetOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_Warehouse_GetOrder_Check</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInput_OrderRegistry_GetOrder">
        <bpmn:sourceRef>DataStoreReference_OrderRegistry</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckGoods" name="Перевірити доставлені товари">
      <bpmn:incoming>Flow_Warehouse_GetOrder_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Warehouse_Check_Match</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_GoodsMatchOrder" name="Товари відповідають замовленню?" default="Flow_Warehouse_No_Reject">
      <bpmn:incoming>Flow_Warehouse_Check_Match</bpmn:incoming>
      <bpmn:outgoing>Flow_Warehouse_Yes_Accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_Warehouse_No_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AcceptDelivery" name="Прийняти доставку">
      <bpmn:incoming>Flow_Warehouse_Yes_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_Warehouse_Accept_Notify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_NotifyManager" name="Повідомити менеджера: доставку прийнято">
      <bpmn:incoming>Flow_Warehouse_Accept_Notify</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageThrowDefinition_DeliveryAccepted" messageRef="Message_DeliveryAccepted" />
    </bpmn:endEvent>
    <bpmn:userTask id="Task_RejectDelivery" name="Не приймати доставку">
      <bpmn:incoming>Flow_Warehouse_No_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Warehouse_Reject_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_DeliveryRejected" name="Доставку відхилено">
      <bpmn:incoming>Flow_Warehouse_Reject_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Warehouse_Start_GetOrder" sourceRef="StartEvent_OrderDelivered" targetRef="Task_GetOrderData" />
    <bpmn:sequenceFlow id="Flow_Warehouse_GetOrder_Check" sourceRef="Task_GetOrderData" targetRef="Task_CheckGoods" />
    <bpmn:sequenceFlow id="Flow_Warehouse_Check_Match" sourceRef="Task_CheckGoods" targetRef="Gateway_GoodsMatchOrder" />
    <bpmn:sequenceFlow id="Flow_Warehouse_Yes_Accept" name="Так" sourceRef="Gateway_GoodsMatchOrder" targetRef="Task_AcceptDelivery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[товари відповідають замовленню]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Warehouse_Accept_Notify" sourceRef="Task_AcceptDelivery" targetRef="EndEvent_NotifyManager" />
    <bpmn:sequenceFlow id="Flow_Warehouse_No_Reject" name="Ні" sourceRef="Gateway_GoodsMatchOrder" targetRef="Task_RejectDelivery" />
    <bpmn:sequenceFlow id="Flow_Warehouse_Reject_End" sourceRef="Task_RejectDelivery" targetRef="EndEvent_DeliveryRejected" />
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_OrderDelivery">
    <bpmn:participant id="Participant_Manager" name="Менеджер" processRef="Process_Manager" />
    <bpmn:participant id="Participant_WarehouseWorker" name="Комірник" processRef="Process_WarehouseWorker" />
    <bpmn:messageFlow id="MessageFlow_NotifyManager" name="Доставку прийнято" sourceRef="EndEvent_NotifyManager" targetRef="IntermediateCatch_DeliveryAccepted" />
  </bpmn:collaboration>

  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderDelivery">
    <bpmndi:BPMNPlane id="BPMNPlane_OrderDelivery" bpmnElement="Collaboration_OrderDelivery">
      <bpmndi:BPMNShape id="Participant_Manager_di" bpmnElement="Participant_Manager" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1260" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_WarehouseWorker_di" bpmnElement="Participant_WarehouseWorker" isHorizontal="true">
        <dc:Bounds x="20" y="390" width="1260" height="300" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_OrderNeeded_di" bpmnElement="StartEvent_OrderNeeded">
        <dc:Bounds x="90" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="52" y="150" width="112" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateOrder_di" bpmnElement="Task_CreateOrder"><dc:Bounds x="170" y="90" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendOrder_di" bpmnElement="Task_SendOrder"><dc:Bounds x="350" y="90" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_WaitForResult_di" bpmnElement="Gateway_WaitForResult">
        <dc:Bounds x="560" y="105" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="518" y="157" width="134" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatch_DeliveryAccepted_di" bpmnElement="IntermediateCatch_DeliveryAccepted">
        <dc:Bounds x="690" y="65" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="632" y="103" width="152" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ManagerAccepted_di" bpmnElement="EndEvent_ManagerAccepted">
        <dc:Bounds x="810" y="65" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="778" y="103" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatch_DeadlineExpired_di" bpmnElement="IntermediateCatch_DeadlineExpired">
        <dc:Bounds x="690" y="195" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="642" y="233" width="132" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ContactTransportCompany_di" bpmnElement="Task_ContactTransportCompany"><dc:Bounds x="780" y="173" width="145" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TransportDecision_di" bpmnElement="Gateway_TransportDecision" isMarkerVisible="true">
        <dc:Bounds x="970" y="188" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="933" y="240" width="124" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_StopWaiting_di" bpmnElement="EndEvent_StopWaiting">
        <dc:Bounds x="1130" y="195" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1097" y="233" width="102" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStoreReference_OrderRegistry_di" bpmnElement="DataStoreReference_OrderRegistry">
        <dc:Bounds x="210" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="176" y="365" width="118" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_OrderDelivered_di" bpmnElement="StartEvent_OrderDelivered">
        <dc:Bounds x="90" y="494" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="52" y="532" width="112" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetOrderData_di" bpmnElement="Task_GetOrderData"><dc:Bounds x="170" y="470" width="145" height="85" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckGoods_di" bpmnElement="Task_CheckGoods"><dc:Bounds x="365" y="470" width="145" height="85" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_GoodsMatchOrder_di" bpmnElement="Gateway_GoodsMatchOrder" isMarkerVisible="true">
        <dc:Bounds x="565" y="487" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="525" y="539" width="130" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AcceptDelivery_di" bpmnElement="Task_AcceptDelivery"><dc:Bounds x="670" y="425" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_NotifyManager_di" bpmnElement="EndEvent_NotifyManager">
        <dc:Bounds x="870" y="447" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="815" y="485" width="146" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectDelivery_di" bpmnElement="Task_RejectDelivery"><dc:Bounds x="670" y="570" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_DeliveryRejected_di" bpmnElement="EndEvent_DeliveryRejected">
        <dc:Bounds x="870" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="835" y="630" width="106" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Manager_Start_Create_di" bpmnElement="Flow_Manager_Start_Create"><di:waypoint x="126" y="130" /><di:waypoint x="170" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Create_Send_di" bpmnElement="Flow_Manager_Create_Send"><di:waypoint x="300" y="130" /><di:waypoint x="350" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Send_Wait_di" bpmnElement="Flow_Manager_Send_Wait"><di:waypoint x="500" y="130" /><di:waypoint x="560" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Wait_AcceptedMessage_di" bpmnElement="Flow_Manager_Wait_AcceptedMessage"><di:waypoint x="585" y="105" /><di:waypoint x="585" y="83" /><di:waypoint x="690" y="83" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Accepted_End_di" bpmnElement="Flow_Manager_Accepted_End"><di:waypoint x="726" y="83" /><di:waypoint x="810" y="83" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Wait_Deadline_di" bpmnElement="Flow_Manager_Wait_Deadline"><di:waypoint x="585" y="155" /><di:waypoint x="585" y="213" /><di:waypoint x="690" y="213" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Deadline_Contact_di" bpmnElement="Flow_Manager_Deadline_Contact"><di:waypoint x="726" y="213" /><di:waypoint x="780" y="213" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Contact_Decision_di" bpmnElement="Flow_Manager_Contact_Decision"><di:waypoint x="925" y="213" /><di:waypoint x="970" y="213" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_WaitAgain_di" bpmnElement="Flow_Manager_WaitAgain">
        <di:waypoint x="995" y="188" /><di:waypoint x="995" y="45" /><di:waypoint x="585" y="45" /><di:waypoint x="585" y="105" />
        <bpmndi:BPMNLabel><dc:Bounds x="760" y="27" width="104" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_StopWaiting_di" bpmnElement="Flow_Manager_StopWaiting">
        <di:waypoint x="1020" y="213" /><di:waypoint x="1130" y="213" />
        <bpmndi:BPMNLabel><dc:Bounds x="1037" y="194" width="78" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Warehouse_Start_GetOrder_di" bpmnElement="Flow_Warehouse_Start_GetOrder"><di:waypoint x="126" y="512" /><di:waypoint x="170" y="512" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Warehouse_GetOrder_Check_di" bpmnElement="Flow_Warehouse_GetOrder_Check"><di:waypoint x="315" y="512" /><di:waypoint x="365" y="512" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Warehouse_Check_Match_di" bpmnElement="Flow_Warehouse_Check_Match"><di:waypoint x="510" y="512" /><di:waypoint x="565" y="512" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Warehouse_Yes_Accept_di" bpmnElement="Flow_Warehouse_Yes_Accept">
        <di:waypoint x="590" y="487" /><di:waypoint x="590" y="465" /><di:waypoint x="670" y="465" />
        <bpmndi:BPMNLabel><dc:Bounds x="624" y="446" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Warehouse_Accept_Notify_di" bpmnElement="Flow_Warehouse_Accept_Notify"><di:waypoint x="810" y="465" /><di:waypoint x="870" y="465" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Warehouse_No_Reject_di" bpmnElement="Flow_Warehouse_No_Reject">
        <di:waypoint x="590" y="537" /><di:waypoint x="590" y="610" /><di:waypoint x="670" y="610" />
        <bpmndi:BPMNLabel><dc:Bounds x="624" y="591" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Warehouse_Reject_End_di" bpmnElement="Flow_Warehouse_Reject_End"><di:waypoint x="810" y="610" /><di:waypoint x="870" y="610" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DataOutput_Create_OrderRegistry_di" bpmnElement="DataOutput_Create_OrderRegistry"><di:waypoint x="235" y="170" /><di:waypoint x="235" y="315" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataInput_OrderRegistry_GetOrder_di" bpmnElement="DataInput_OrderRegistry_GetOrder"><di:waypoint x="235" y="365" /><di:waypoint x="242" y="470" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_NotifyManager_di" bpmnElement="MessageFlow_NotifyManager">
        <di:waypoint x="888" y="447" /><di:waypoint x="888" y="340" /><di:waypoint x="708" y="340" /><di:waypoint x="708" y="101" />
        <bpmndi:BPMNLabel><dc:Bounds x="734" y="321" width="128" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
